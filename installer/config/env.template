# ============================================================================
# ULTRA-CREATE v21.4 - Configuration API Keys
# ============================================================================
# Copiez ce fichier vers C:\Claude-Code-Creation\.env
# Remplissez les valeurs avec vos propres cles API
# ============================================================================

# ============================================================================
# OBLIGATOIRE
# ============================================================================

# Anthropic API Key (requis pour Claude Code CLI)
# Obtenez-la sur: https://console.anthropic.com
ANTHROPIC_API_KEY=

# GitHub Personal Access Token (requis pour MCP GitHub, /research)
# Creez-le sur: https://github.com/settings/tokens
# Scopes requis: repo, read:user
GITHUB_PERSONAL_ACCESS_TOKEN=

# ============================================================================
# BACKEND / DATABASE
# ============================================================================

# Supabase (pour projets backend)
# Dashboard: https://supabase.com/dashboard
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_URL=
SUPABASE_ANON_KEY=

# PostgreSQL local (pour Hindsight)
POSTGRES_CONNECTION_STRING=postgresql://hindsight:hindsight_password@localhost:5433/hindsight

# ============================================================================
# CODE EXECUTION
# ============================================================================

# E2B Code Execution (sandbox securise)
# Obtenez-la sur: https://e2b.dev
E2B_API_KEY=

# ============================================================================
# RECHERCHE / SCRAPING
# ============================================================================

# Firecrawl (web scraping avance)
# Obtenez-la sur: https://firecrawl.dev
FIRECRAWL_API_KEY=

# Exa Search (recherche web IA)
# Obtenez-la sur: https://exa.ai
EXA_API_KEY=

# ============================================================================
# DESIGN / PRODUCTIVITY
# ============================================================================

# Notion API (integration Notion)
# Obtenez-la sur: https://www.notion.so/my-integrations
NOTION_API_KEY=

# Figma Access Token (integration Figma)
# Obtenez-le sur: https://www.figma.com/developers/api#access-tokens
FIGMA_ACCESS_TOKEN=

# ============================================================================
# CLOUD / DEPLOYMENT
# ============================================================================

# OpenAI (optionnel - pour certains MCPs)
OPENAI_API_KEY=

# Vercel Token (optionnel - pour deploiement auto)
VERCEL_TOKEN=

# ============================================================================
# HINDSIGHT (LOCAL)
# ============================================================================

# Configuration Hindsight (ne pas modifier)
HINDSIGHT_API_URL=http://localhost:8888

# ============================================================================
# SYSTEME (AUTO-GENERE)
# ============================================================================

# Chemin d'installation ULTRA-CREATE
ULTRA_CREATE_PATH=C:\Claude-Code-Creation

# ============================================================================
# NOTES
# ============================================================================
#
# - Les cles sont stockees localement, jamais transmises
# - Gardez ce fichier prive, ne le commitez jamais sur Git
# - Ajoutez .env a votre .gitignore
# - Redemarrez Claude Code apres modification
#
# ============================================================================
