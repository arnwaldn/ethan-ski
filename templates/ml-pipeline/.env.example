# MLflow
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME={{APP_NAME}}

# Model serving
MODEL_URI=models:/{{APP_NAME}}_model/Production
MODEL_NAME={{APP_NAME}}_model

# API
API_HOST=0.0.0.0
API_PORT=8000

# AWS (optional for S3 artifacts)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# Weights & Biases (optional)
WANDB_API_KEY=
WANDB_PROJECT={{APP_NAME}}
